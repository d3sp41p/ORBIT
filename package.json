{
  "name": "orbit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check:cyrillic": "node scripts/check-cyrillic.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:cyrillic",
    "db:migrate": "node scripts/migrate.mjs",
    "fixtures:capture": "node scripts/capture-fixtures.mjs",
    "launch": "node scripts/launch.mjs launch",
    "launch:arm": "node scripts/launch.mjs arm",
    "launch:status": "node scripts/launch.mjs status",
    "launch:disarm": "node scripts/launch.mjs disarm",
    "launch:reset": "node scripts/launch.mjs reset",
    "launch:test": "node scripts/launch.mjs test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "globals": "^16.5.0",
    "pg": "^8.23.1",
    "playwright-core": "1.64.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
