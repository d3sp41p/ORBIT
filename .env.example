# Copy to .env.local for local development. Real values live only in the
# hosting settings (Vercel, Railway). Never commit any other .env file.

# --- Token ---
# Stand-in token for development only. The real coin is set at launch in the
# database (pnpm launch:arm / pnpm launch), not here.
TOKEN_MINT=
TOKEN_TICKER=ORBIT
TOKEN_NAME=ORBIT
BUY_URL=
X_URL=

# --- Helius ---
HELIUS_API_KEY=
# Shared secret of the webhook (web checks it, worker sets it on the Helius webhook)
HELIUS_WEBHOOK_SECRET=
# Public URL of the webhook route; the worker creates and updates the Helius webhook
WEBHOOK_URL=https://orbit-green-chi.vercel.app/api/webhooks/helius

# --- Supabase ---
# Public: may reach the browser (web)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret: server only (worker, API routes)
SUPABASE_SERVICE_ROLE_KEY=
# Secret: direct Postgres connection for migrations and the worker
# (Project Settings -> Database -> Connection string -> Session pooler)
SUPABASE_DB_URL=

# --- Anthropic (worker) ---
ANTHROPIC_API_KEY=
AI_DAILY_BUDGET_USD=2.5

# --- Game rules (worker) ---
# Program accounts (pump.fun bonding curve, pools) are excluded automatically.
# Comma-separated wallets to exclude as well: burn address, team wallets
EXCLUDED_WALLETS=
# Program-owned wallets to keep anyway (e.g. a multisig vault of a real holder)
INCLUDED_WALLETS=
# Minimum balance (whole tokens) to be a planet
MIN_HOLDING_TOKENS=100000

# --- Preview (web) ---
# Before launch real data is hidden; ?preview=<PREVIEW_KEY> shows it (testing).
PREVIEW_KEY=

# --- Moderation (API) ---
# Comma-separated admin wallet addresses
ADMIN_WALLETS=

# --- Worker runtime ---
PORT=8080
# Reconciliation snapshot interval in seconds (spec: 60; larger saves Helius credits)
SNAPSHOT_INTERVAL_SEC=60
# Max transactions to read when restoring history into an empty database
BACKFILL_LIMIT=20000
