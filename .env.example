# Copy to .env.local for local development. Real values live only in the
# hosting settings (Vercel, Railway). Never commit any other .env file.

# --- Token (web, worker) ---
TOKEN_MINT=
TOKEN_TICKER=ORBIT
TOKEN_NAME=ORBIT
BUY_URL=
X_URL=

# --- Helius (worker) ---
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=

# --- Supabase ---
# Public: may reach the browser (web)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret: server only (worker, API routes)
SUPABASE_SERVICE_ROLE_KEY=
# Secret: direct Postgres connection for migrations and the worker
# (Project Settings -> Database -> Connection string -> Session pooler)
SUPABASE_DB_URL=

# --- Anthropic (worker) ---
ANTHROPIC_API_KEY=
AI_DAILY_BUDGET_USD=5

# --- Game rules (worker) ---
# Program accounts (pump.fun bonding curve, pools) are excluded automatically.
# Comma-separated wallets to exclude as well: burn address, team wallets
EXCLUDED_WALLETS=
# Program-owned wallets to keep anyway (e.g. a multisig vault of a real holder)
INCLUDED_WALLETS=
# Minimum balance (whole tokens) to be a planet
MIN_HOLDING_TOKENS=100000

# --- Moderation (API) ---
# Comma-separated admin wallet addresses
ADMIN_WALLETS=

# --- Worker runtime ---
PORT=8080
