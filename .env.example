# Copy to .env.local for local development. Real values live only in the
# hosting settings (Vercel, Railway). Never commit any other .env file.

# --- Token (web, worker) ---
TOKEN_MINT=
TOKEN_TICKER=ORBIT
TOKEN_NAME=ORBIT
BUY_URL=
X_URL=

# --- Helius (worker) ---
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=

# --- Supabase ---
# Public: may reach the browser (web)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret: server only (worker, API routes)
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (worker) ---
ANTHROPIC_API_KEY=
AI_DAILY_BUDGET_USD=5

# --- Game rules (worker) ---
# Comma-separated wallet addresses: liquidity pool, bonding curve, burn address, team wallets
EXCLUDED_WALLETS=
MIN_HOLDING_TOKENS=1

# --- Moderation (API) ---
# Comma-separated admin wallet addresses
ADMIN_WALLETS=

# --- Worker runtime ---
PORT=8080
